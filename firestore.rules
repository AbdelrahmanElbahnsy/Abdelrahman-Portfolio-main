rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── ROLE-BASED ACCESS CONTROL (RBAC) FUNCTIONS ──────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      // Safely fetch role from the admins collection (returns null if doesn't exist)
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : null;
    }

    function isOwner() {
      return getRole() == 'owner';
    }

    function isAdmin() {
      return getRole() == 'admin' || isOwner();
    }

    function isEditor() {
      return getRole() == 'editor' || isAdmin();
    }

    function isViewer() {
      // If they have any valid role, they are at least a viewer
      return getRole() in ['owner', 'admin', 'editor', 'viewer'];
    }

    // ─── ADMINS & USERS COLLECTION ───────────────────────────────────────────
    match /admins/{userId} {
      // Users can read their own role; Owners and Admins can read all roles.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // All writes to /admins are strictly disabled from the client.
      // Modifying roles/access MUST go through the secure Vercel API (/api/admin/users)
      // This prevents ANY client-side privilege escalation or accidental lockout.
      allow write: if false; 
    }

    // ─── CMS PORTFOLIO CONTENT (PUBLIC READ, EDITOR+ WRITE) ──────────────────
    // Public visitors can ONLY read. 
    // Owners, Admins, and Editors can read, create, update, delete.
    
    match /hero/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /about/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /skills/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /journey/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /projects/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /certifications/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /socials/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /contact/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /navbarItems/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /profile/{document=**} { allow read: if true; allow write: if isEditor(); }
    match /settings/appearance { allow read: if true; allow create, update: if isEditor(); }

    // ─── ANALYTICS ───────────────────────────────────────────────────────────
    match /visits/{document=**} {
      // Public can record visits
      allow create: if true;
      // Only Admin+ can read/modify analytics
      allow read, update, delete: if isAdmin();
    }

    // ─── INTERNAL AUDIT TRAIL ────────────────────────────────────────────────
    match /activityLog/{document=**} {
      // Only Admin+ can read/write activity logs
      allow read, write: if isAdmin();
    }

    // ─── DEFAULT DENY ────────────────────────────────────────────────────────
    // Safely block access to any other collections not explicitly defined above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
